{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "$ref": "#/$defs/__schema0" },
    "evaluation_id": { "$ref": "#/$defs/__schema1" },
    "evaluation_version": { "$ref": "#/$defs/__schema2" },
    "mode": { "$ref": "#/$defs/__schema3" },
    "frozen": { "$ref": "#/$defs/__schema4" },
    "dirty_generated_artifacts": { "$ref": "#/$defs/__schema5" },
    "source_commit": { "$ref": "#/$defs/__schema6" },
    "generated_contracts_sha256": { "$ref": "#/$defs/__schema7" },
    "fixtures": { "$ref": "#/$defs/__schema8" }
  },
  "required": [
    "schema",
    "evaluation_id",
    "evaluation_version",
    "mode",
    "frozen",
    "dirty_generated_artifacts",
    "source_commit",
    "generated_contracts_sha256",
    "fixtures"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "string", "const": "EVLLM_EVALUATION_CONFIG_V1" },
    "__schema1": {
      "type": "string",
      "pattern": "^urn:evllm:case:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema2": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema3": { "type": "string", "enum": ["development", "formal"] },
    "__schema4": { "type": "boolean" },
    "__schema5": { "type": "boolean" },
    "__schema6": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "__schema7": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "__schema8": { "minItems": 1, "type": "array", "items": { "$ref": "#/$defs/__schema9" } },
    "__schema9": {
      "type": "string",
      "pattern": "^urn:evllm:source:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
