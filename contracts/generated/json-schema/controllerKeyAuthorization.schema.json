{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_CONTROLLER_KEY_AUTHORIZATION_V1" },
    "authorization_id": {
      "type": "string",
      "pattern": "^urn:evllm:authorization:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "authorization_version": { "$ref": "#/$defs/__schema0" },
    "bundle_id": {
      "type": "string",
      "pattern": "^urn:evllm:bundle:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "bundle_version": { "$ref": "#/$defs/__schema0" },
    "controller_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "controller_key_id": {
      "type": "string",
      "pattern": "^urn:evllm:key:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "envelope_id": {
      "type": "string",
      "pattern": "^urn:evllm:envelope:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": ["staged", "active", "retired", "revoked", "unavailable"]
    },
    "predecessor_authorization_id": {
      "type": "string",
      "pattern": "^urn:evllm:authorization:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "successor_authorization_id": {
      "type": "string",
      "pattern": "^urn:evllm:authorization:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": { "$ref": "#/$defs/__schema1" },
    "activated_at": { "$ref": "#/$defs/__schema1" },
    "retired_at": { "$ref": "#/$defs/__schema1" }
  },
  "required": [
    "schema",
    "authorization_id",
    "authorization_version",
    "bundle_id",
    "bundle_version",
    "controller_organization_id",
    "controller_key_id",
    "envelope_id",
    "status",
    "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
