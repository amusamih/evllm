{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_EVALUATION_CASE_V1" },
    "case_id": {
      "type": "string",
      "pattern": "^urn:evllm:case:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "case_version": { "$ref": "#/$defs/__schema0" },
    "source_class": {
      "type": "string",
      "enum": ["public-data-replay", "synthetic-generator", "scripted-report"]
    },
    "licence": { "$ref": "#/$defs/__schema1" },
    "actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "task": { "$ref": "#/$defs/__schema2" },
    "fixture_refs": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema3" }
    },
    "adverse_condition": { "$ref": "#/$defs/__schema1" },
    "expected_state": { "$ref": "#/$defs/__schema1" },
    "adjudication_basis": { "$ref": "#/$defs/__schema2" },
    "allowed_outputs": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema1" }
    },
    "metrics": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema1" }
    },
    "exclusion_flags": {
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema1" }
    },
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  },
  "required": [
    "schema",
    "case_id",
    "case_version",
    "source_class",
    "licence",
    "actor_id",
    "task",
    "fixture_refs",
    "expected_state",
    "adjudication_basis",
    "allowed_outputs",
    "metrics",
    "exclusion_flags",
    "schema_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": { "type": "string", "minLength": 1, "maxLength": 256 },
    "__schema2": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/__schema0" }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    }
  }
}
