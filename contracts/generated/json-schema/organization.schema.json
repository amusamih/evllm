{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_ORGANIZATION_V1" },
    "organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "organization_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": { "type": "string", "enum": ["pending", "active", "suspended", "revoked"] },
    "admitted_role_ids": {
      "maxItems": 128,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema0" }
    },
    "administrator_actor_ids": {
      "maxItems": 128,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema1" }
    },
    "repository_ids": {
      "maxItems": 128,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema2" }
    },
    "legal_identity_limitation": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "effective_at": { "$ref": "#/$defs/__schema3" },
    "recorded_at": { "$ref": "#/$defs/__schema3" }
  },
  "required": [
    "schema",
    "organization_id",
    "organization_version",
    "name",
    "status",
    "admitted_role_ids",
    "administrator_actor_ids",
    "repository_ids",
    "legal_identity_limitation",
    "effective_at",
    "recorded_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^urn:evllm:role:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^urn:evllm:repository:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema3": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
