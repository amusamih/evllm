{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_ACTOR_CREDENTIAL_V1" },
    "credential_id": {
      "type": "string",
      "pattern": "^urn:evllm:credential:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "credential_version": { "type": "number", "const": 1 },
    "actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "wallet_address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "status": {
      "type": "string",
      "enum": ["pending", "active", "retired", "revoked", "compromised"]
    },
    "predecessor_credential_id": {
      "type": "string",
      "pattern": "^urn:evllm:credential:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "successor_credential_id": {
      "type": "string",
      "pattern": "^urn:evllm:credential:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "role_ids": { "maxItems": 128, "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
    "effective_at": { "$ref": "#/$defs/__schema1" },
    "recorded_at": { "$ref": "#/$defs/__schema1" },
    "revocation_reason": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "required": [
    "schema",
    "credential_id",
    "credential_version",
    "actor_id",
    "organization_id",
    "wallet_address",
    "status",
    "role_ids",
    "effective_at",
    "recorded_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^urn:evllm:role:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema1": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
