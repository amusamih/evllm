{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_INITIAL_OWNERSHIP_BINDING_V1" },
    "ownership_proposal_id": {
      "type": "string",
      "pattern": "^urn:evllm:ownership:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ownership_proposal_version": { "type": "number", "const": 1 },
    "battery_id": {
      "type": "string",
      "pattern": "^urn:evllm:battery:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "registrar_actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nominated_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "supporting_evidence_id": {
      "type": "string",
      "pattern": "^urn:evllm:evidence:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "supporting_evidence_version": { "$ref": "#/$defs/__schema0" },
    "supporting_commitment": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "required": ["alg", "value"],
      "additionalProperties": false
    },
    "registrar_confirmation_id": {
      "type": "string",
      "pattern": "^urn:evllm:transition:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "owner_confirmation_id": {
      "type": "string",
      "pattern": "^urn:evllm:transition:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "terminal_transition_id": {
      "type": "string",
      "pattern": "^urn:evllm:transition:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nonce": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "expires_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "state": { "type": "string", "enum": ["proposed", "accepted", "rejected", "expired"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 256 },
    "chain_id": { "$ref": "#/$defs/__schema0" },
    "transaction_hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  },
  "required": [
    "schema",
    "ownership_proposal_id",
    "ownership_proposal_version",
    "battery_id",
    "registrar_actor_id",
    "nominated_organization_id",
    "supporting_evidence_id",
    "supporting_evidence_version",
    "supporting_commitment",
    "registrar_confirmation_id",
    "nonce",
    "expires_at",
    "state",
    "chain_id"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
  }
}
