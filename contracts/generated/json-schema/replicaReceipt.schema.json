{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_REPLICA_RECEIPT_V1" },
    "receipt_id": {
      "type": "string",
      "pattern": "^urn:evllm:receipt:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "receipt_version": { "$ref": "#/$defs/__schema0" },
    "eip712_profile_id": {
      "type": "string",
      "pattern": "^urn:evllm:profile:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eip712_profile_version": { "$ref": "#/$defs/__schema0" },
    "chain_id": { "$ref": "#/$defs/__schema0" },
    "verifying_contract": { "$ref": "#/$defs/__schema1" },
    "bundle_id": {
      "type": "string",
      "pattern": "^urn:evllm:bundle:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "bundle_version": { "$ref": "#/$defs/__schema0" },
    "bundle_type": {
      "type": "string",
      "enum": [
        "evidence",
        "verification",
        "assessment",
        "assistant-support",
        "listing",
        "agreement",
        "dispute",
        "logistics",
        "audit",
        "authoritative-source"
      ]
    },
    "domain_resource_id": { "type": "string", "pattern": "^urn:evllm:.*" },
    "domain_resource_version": { "$ref": "#/$defs/__schema0" },
    "content_envelope_digest": { "$ref": "#/$defs/__schema2" },
    "stored_envelope_length": { "$ref": "#/$defs/__schema0" },
    "replica_repository_id": {
      "type": "string",
      "pattern": "^urn:evllm:repository:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "replica_custodian_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "criticality_profile_id": {
      "type": "string",
      "pattern": "^urn:evllm:profile:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "criticality_profile_version": { "$ref": "#/$defs/__schema0" },
    "signer_credential_id": {
      "type": "string",
      "pattern": "^urn:evllm:credential:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "signer_address": { "$ref": "#/$defs/__schema1" },
    "nonce": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "observed_at": { "$ref": "#/$defs/__schema3" },
    "expires_at": { "$ref": "#/$defs/__schema3" },
    "signature": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"
    },
    "receipt_digest": { "$ref": "#/$defs/__schema2" }
  },
  "required": [
    "schema",
    "receipt_id",
    "receipt_version",
    "eip712_profile_id",
    "eip712_profile_version",
    "chain_id",
    "verifying_contract",
    "bundle_id",
    "bundle_version",
    "bundle_type",
    "domain_resource_id",
    "domain_resource_version",
    "content_envelope_digest",
    "stored_envelope_length",
    "replica_repository_id",
    "replica_custodian_organization_id",
    "criticality_profile_id",
    "criticality_profile_version",
    "signer_credential_id",
    "signer_address",
    "nonce",
    "observed_at",
    "expires_at",
    "signature",
    "receipt_digest"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "__schema2": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "required": ["alg", "value"],
      "additionalProperties": false
    },
    "__schema3": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
