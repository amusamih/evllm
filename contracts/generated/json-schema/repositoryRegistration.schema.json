{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_REPOSITORY_REGISTRATION_V1" },
    "repository_id": {
      "type": "string",
      "pattern": "^urn:evllm:repository:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "repository_version": { "$ref": "#/$defs/__schema0" },
    "custody_controller_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "infrastructure_operator_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "protocol_version": { "$ref": "#/$defs/__schema1" },
    "adapter_version": { "$ref": "#/$defs/__schema1" },
    "endpoint_alias": { "$ref": "#/$defs/__schema2" },
    "supported_operations": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema2" }
    },
    "conformance_result": { "type": "string", "enum": ["pass", "fail"] },
    "status": { "type": "string", "enum": ["pending", "active", "unavailable", "retired"] },
    "approved_replica_scopes": {
      "maxItems": 128,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema3" }
    }
  },
  "required": [
    "schema",
    "repository_id",
    "repository_version",
    "custody_controller_organization_id",
    "infrastructure_operator_organization_id",
    "protocol_version",
    "adapter_version",
    "endpoint_alias",
    "supported_operations",
    "conformance_result",
    "status",
    "approved_replica_scopes"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "__schema2": { "type": "string", "minLength": 1, "maxLength": 256 },
    "__schema3": {
      "type": "object",
      "properties": {
        "resource_id": { "type": "string", "minLength": 1 },
        "resource_version": { "$ref": "#/$defs/__schema0" }
      },
      "required": ["resource_id"],
      "additionalProperties": false
    }
  }
}
