{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_RULE_PROFILE_V1" },
    "rule_id": {
      "type": "string",
      "pattern": "^urn:evllm:rule:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "rule_version": { "$ref": "#/$defs/__schema0" },
    "source_clauses": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema1" }
    },
    "jurisdiction": { "$ref": "#/$defs/__schema2" },
    "effective_from": { "$ref": "#/$defs/__schema3" },
    "effective_until": { "$ref": "#/$defs/__schema3" },
    "subject_scope": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema2" }
    },
    "predicates": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema2" }
    },
    "required_evidence": {
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema2" }
    },
    "outcomes": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema2" }
    },
    "reason_codes": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema2" }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "active", "disabled", "superseded", "retired"]
    },
    "review_due_at": { "$ref": "#/$defs/__schema3" }
  },
  "required": [
    "schema",
    "rule_id",
    "rule_version",
    "source_clauses",
    "jurisdiction",
    "effective_from",
    "subject_scope",
    "predicates",
    "required_evidence",
    "outcomes",
    "reason_codes",
    "status",
    "review_due_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/__schema0" }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "__schema2": { "type": "string", "minLength": 1, "maxLength": 256 },
    "__schema3": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
