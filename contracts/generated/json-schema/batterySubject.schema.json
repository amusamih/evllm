{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_BATTERY_SUBJECT_V1" },
    "battery_id": {
      "type": "string",
      "pattern": "^urn:evllm:battery:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "battery_version": { "$ref": "#/$defs/__schema0" },
    "granularity": { "type": "string", "enum": ["pack", "module", "cell"] },
    "registration_issuer_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "subject_schema_id": {
      "type": "string",
      "pattern": "^urn:evllm:schema:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "subject_schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": { "type": "string", "enum": ["pending", "active", "locked", "retired"] },
    "parent_battery_id": {
      "type": "string",
      "pattern": "^urn:evllm:battery:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "parent_relation_version": { "$ref": "#/$defs/__schema0" }
  },
  "required": [
    "schema",
    "battery_id",
    "battery_version",
    "granularity",
    "registration_issuer_organization_id",
    "subject_schema_id",
    "subject_schema_version",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
  }
}
