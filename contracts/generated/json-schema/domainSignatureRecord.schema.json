{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_DOMAIN_SIGNATURE_RECORD_V1" },
    "signature_record_id": {
      "type": "string",
      "pattern": "^urn:evllm:assertion:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "signature_record_version": { "$ref": "#/$defs/__schema0" },
    "bundle_id": {
      "type": "string",
      "pattern": "^urn:evllm:bundle:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "bundle_version": { "$ref": "#/$defs/__schema0" },
    "bundle_type": {
      "type": "string",
      "enum": [
        "evidence",
        "verification",
        "assessment",
        "assistant-support",
        "listing",
        "agreement",
        "dispute",
        "logistics",
        "audit",
        "authoritative-source"
      ]
    },
    "domain_resource_id": { "type": "string", "pattern": "^urn:evllm:.*" },
    "domain_resource_version": { "$ref": "#/$defs/__schema0" },
    "payload_type": { "type": "string", "minLength": 1, "maxLength": 256 },
    "eip712_profile_id": {
      "type": "string",
      "pattern": "^urn:evllm:profile:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eip712_profile_version": { "$ref": "#/$defs/__schema0" },
    "author_binding_profile_id": {
      "type": "string",
      "pattern": "^urn:evllm:profile:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "author_binding_profile_version": { "$ref": "#/$defs/__schema0" },
    "author_binding_decision_id": {
      "type": "string",
      "pattern": "^urn:evllm:decision:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "signer_actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "signer_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "signer_credential_id": {
      "type": "string",
      "pattern": "^urn:evllm:credential:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "signer_address": { "$ref": "#/$defs/__schema1" },
    "chain_id": { "$ref": "#/$defs/__schema0" },
    "verifying_contract": { "$ref": "#/$defs/__schema1" },
    "nonce": { "$ref": "#/$defs/__schema2" },
    "issued_at": { "$ref": "#/$defs/__schema3" },
    "expires_at": { "$ref": "#/$defs/__schema3" },
    "domain_payload_commitment": { "$ref": "#/$defs/__schema4" },
    "signature": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"
    },
    "typed_data_digest": { "$ref": "#/$defs/__schema2" },
    "signature_digest": { "$ref": "#/$defs/__schema4" },
    "signed_domain_envelope_digest": { "$ref": "#/$defs/__schema4" },
    "state": { "type": "string", "enum": ["accepted", "reorganized", "rejected"] },
    "accepted_at": { "$ref": "#/$defs/__schema3" },
    "chain_locator": {
      "type": "object",
      "properties": {
        "chain_id": { "$ref": "#/$defs/__schema0" },
        "transaction_hash": { "$ref": "#/$defs/__schema2" },
        "block_number": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "log_index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["chain_id", "transaction_hash", "block_number", "log_index"],
      "additionalProperties": false
    },
    "audit_event_id": {
      "type": "string",
      "pattern": "^urn:evllm:event:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "schema",
    "signature_record_id",
    "signature_record_version",
    "bundle_id",
    "bundle_version",
    "bundle_type",
    "domain_resource_id",
    "domain_resource_version",
    "payload_type",
    "eip712_profile_id",
    "eip712_profile_version",
    "author_binding_profile_id",
    "author_binding_profile_version",
    "author_binding_decision_id",
    "signer_actor_id",
    "signer_organization_id",
    "signer_credential_id",
    "signer_address",
    "chain_id",
    "verifying_contract",
    "nonce",
    "issued_at",
    "expires_at",
    "domain_payload_commitment",
    "signature",
    "typed_data_digest",
    "signature_digest",
    "signed_domain_envelope_digest",
    "state",
    "accepted_at",
    "audit_event_id"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "__schema2": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "__schema3": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "__schema4": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "required": ["alg", "value"],
      "additionalProperties": false
    }
  }
}
