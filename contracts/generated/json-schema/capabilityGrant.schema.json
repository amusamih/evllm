{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_CAPABILITY_GRANT_V1" },
    "grant_id": {
      "type": "string",
      "pattern": "^urn:evllm:grant:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "grant_version": { "$ref": "#/$defs/__schema0" },
    "actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "role_id": {
      "type": "string",
      "pattern": "^urn:evllm:role:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^urn:evllm:capability:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "resource_scope": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema1" }
    },
    "claim_method_scope": {
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema2" }
    },
    "effective_at": { "$ref": "#/$defs/__schema3" },
    "expires_at": { "$ref": "#/$defs/__schema3" },
    "grantor_actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": { "type": "string", "enum": ["prepared", "active", "revoked"] },
    "reason": { "$ref": "#/$defs/__schema2" },
    "policy_id": {
      "type": "string",
      "pattern": "^urn:evllm:policy:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "policy_version": { "$ref": "#/$defs/__schema0" }
  },
  "required": [
    "schema",
    "grant_id",
    "grant_version",
    "actor_id",
    "organization_id",
    "role_id",
    "capability_id",
    "resource_scope",
    "claim_method_scope",
    "effective_at",
    "expires_at",
    "grantor_actor_id",
    "status",
    "reason",
    "policy_id",
    "policy_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": {
      "type": "object",
      "properties": {
        "resource_id": { "type": "string", "minLength": 1 },
        "resource_version": { "$ref": "#/$defs/__schema0" }
      },
      "required": ["resource_id"],
      "additionalProperties": false
    },
    "__schema2": { "type": "string", "minLength": 1, "maxLength": 256 },
    "__schema3": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
