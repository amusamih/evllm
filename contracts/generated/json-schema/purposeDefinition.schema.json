{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_PURPOSE_DEFINITION_V1" },
    "purpose_id": {
      "type": "string",
      "pattern": "^urn:evllm:policy:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "purpose_version": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "status": { "type": "string", "enum": ["pending", "active", "retired"] },
    "effective_at": { "$ref": "#/$defs/__schema0" },
    "recorded_at": { "$ref": "#/$defs/__schema0" }
  },
  "required": [
    "schema",
    "purpose_id",
    "purpose_version",
    "code",
    "description",
    "status",
    "effective_at",
    "recorded_at"
  ],
  "additionalProperties": false,
  "$defs": { "__schema0": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } }
}
