{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_ACCESS_GRANT_V1" },
    "grant_id": {
      "type": "string",
      "pattern": "^urn:evllm:grant:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "grant_version": { "$ref": "#/$defs/__schema0" },
    "bundle_id": {
      "type": "string",
      "pattern": "^urn:evllm:bundle:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "bundle_version": { "$ref": "#/$defs/__schema0" },
    "domain_resource_id": { "type": "string", "pattern": "^urn:evllm:.*" },
    "domain_resource_version": { "$ref": "#/$defs/__schema0" },
    "recipient_actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "recipient_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "purpose_id": {
      "type": "string",
      "pattern": "^urn:evllm:policy:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operations": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema1" }
    },
    "policy_id": {
      "type": "string",
      "pattern": "^urn:evllm:policy:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "policy_version": { "$ref": "#/$defs/__schema0" },
    "effective_at": { "$ref": "#/$defs/__schema2" },
    "expires_at": { "$ref": "#/$defs/__schema2" },
    "envelope_id": {
      "type": "string",
      "pattern": "^urn:evllm:envelope:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": { "type": "string", "enum": ["prepared", "active", "revoked"] },
    "revocation_reason": { "$ref": "#/$defs/__schema1" }
  },
  "required": [
    "schema",
    "grant_id",
    "grant_version",
    "bundle_id",
    "bundle_version",
    "domain_resource_id",
    "domain_resource_version",
    "recipient_actor_id",
    "recipient_organization_id",
    "purpose_id",
    "operations",
    "policy_id",
    "policy_version",
    "effective_at",
    "expires_at",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": { "type": "string", "minLength": 1, "maxLength": 256 },
    "__schema2": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
