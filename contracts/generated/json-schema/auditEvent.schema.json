{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_AUDIT_EVENT_V1" },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^urn:evllm:event:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "event_version": { "type": "number", "const": 1 },
    "sequence": { "$ref": "#/$defs/__schema0" },
    "process": { "$ref": "#/$defs/__schema1" },
    "origin_type": {
      "type": "string",
      "enum": ["registered-actor", "permissionless-wallet", "service-process"]
    },
    "caller_address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "caller_process": { "$ref": "#/$defs/__schema1" },
    "actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "purpose_id": {
      "type": "string",
      "pattern": "^urn:evllm:policy:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operation": { "$ref": "#/$defs/__schema1" },
    "resource_refs": { "maxItems": 256, "type": "array", "items": { "$ref": "#/$defs/__schema2" } },
    "policy_result": { "type": "string", "enum": ["allow", "deny", "not-applicable"] },
    "result_status": { "$ref": "#/$defs/__schema1" },
    "permitted_digests": {
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema3" }
    },
    "recorded_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "previous_event_hash": { "$ref": "#/$defs/__schema3" },
    "event_hash": { "$ref": "#/$defs/__schema3" },
    "privacy_class": { "type": "string", "enum": ["public", "minimized", "restricted-reference"] }
  },
  "required": [
    "schema",
    "correlation_id",
    "event_id",
    "event_version",
    "sequence",
    "process",
    "origin_type",
    "purpose_id",
    "operation",
    "resource_refs",
    "policy_result",
    "result_status",
    "permitted_digests",
    "recorded_at",
    "event_hash",
    "privacy_class"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": { "type": "string", "minLength": 1, "maxLength": 256 },
    "__schema2": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/__schema0" }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "required": ["alg", "value"],
      "additionalProperties": false
    }
  }
}
