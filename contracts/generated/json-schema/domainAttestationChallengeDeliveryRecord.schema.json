{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "EVLLM_DOMAIN_ATTESTATION_CHALLENGE_DELIVERY_RECORD_V1"
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^urn:evllm:challenge:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "staging_id": {
      "type": "string",
      "pattern": "^urn:evllm:staging:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "staging_descriptor_digest": { "$ref": "#/$defs/__schema0" },
    "challenge_digest": { "$ref": "#/$defs/__schema0" },
    "intended_author_actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "intended_author_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "intended_author_credential_id": {
      "type": "string",
      "pattern": "^urn:evllm:credential:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "intended_author_address": { "$ref": "#/$defs/__schema1" },
    "author_binding_profile_id": {
      "type": "string",
      "pattern": "^urn:evllm:profile:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "author_binding_profile_version": { "$ref": "#/$defs/__schema2" },
    "eip712_profile_id": {
      "type": "string",
      "pattern": "^urn:evllm:profile:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eip712_profile_version": { "$ref": "#/$defs/__schema2" },
    "domain_name": { "$ref": "#/$defs/__schema3" },
    "domain_version": { "$ref": "#/$defs/__schema3" },
    "chain_id": { "$ref": "#/$defs/__schema2" },
    "protected_bundle_registry_address": { "$ref": "#/$defs/__schema1" },
    "attribution_nonce": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "issued_at": { "$ref": "#/$defs/__schema4" },
    "expires_at": { "$ref": "#/$defs/__schema4" },
    "state": { "type": "string", "enum": ["prepared", "delivered", "expired"] },
    "prepared_at": { "$ref": "#/$defs/__schema4" },
    "delivered_at": { "$ref": "#/$defs/__schema4" },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "audit_event_id": {
      "type": "string",
      "pattern": "^urn:evllm:event:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "schema",
    "challenge_id",
    "staging_id",
    "staging_descriptor_digest",
    "challenge_digest",
    "intended_author_actor_id",
    "intended_author_organization_id",
    "intended_author_credential_id",
    "intended_author_address",
    "author_binding_profile_id",
    "author_binding_profile_version",
    "eip712_profile_id",
    "eip712_profile_version",
    "domain_name",
    "domain_version",
    "chain_id",
    "protected_bundle_registry_address",
    "attribution_nonce",
    "issued_at",
    "expires_at",
    "state",
    "prepared_at",
    "correlation_id",
    "audit_event_id"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "required": ["alg", "value"],
      "additionalProperties": false
    },
    "__schema1": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "__schema2": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema3": { "type": "string", "minLength": 1, "maxLength": 256 },
    "__schema4": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
