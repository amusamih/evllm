{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "$ref": "#/$defs/__schema0" },
    "fixture_id": { "$ref": "#/$defs/__schema1" },
    "fixture_version": { "$ref": "#/$defs/__schema2" },
    "source_class": { "$ref": "#/$defs/__schema3" },
    "source_uri": { "$ref": "#/$defs/__schema4" },
    "licence_id": { "$ref": "#/$defs/__schema5" },
    "generator_id": { "$ref": "#/$defs/__schema6" },
    "generator_version": { "$ref": "#/$defs/__schema7" },
    "content_sha256": { "$ref": "#/$defs/__schema8" },
    "derived_from": { "$ref": "#/$defs/__schema9" }
  },
  "required": [
    "schema",
    "fixture_id",
    "fixture_version",
    "source_class",
    "content_sha256",
    "derived_from"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "string", "const": "EVLLM_FIXTURE_MANIFEST_V1" },
    "__schema1": {
      "type": "string",
      "pattern": "^urn:evllm:source:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema2": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema3": {
      "type": "string",
      "enum": ["public-data-replay", "synthetic-generator", "scripted-report"]
    },
    "__schema4": { "type": "string", "format": "uri" },
    "__schema5": { "type": "string", "minLength": 1 },
    "__schema6": { "type": "string", "minLength": 1 },
    "__schema7": { "type": "string", "minLength": 1 },
    "__schema8": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "__schema9": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:evllm:source:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    }
  }
}
