{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_CUSTODY_RELATIONSHIP_V1" },
    "relationship_id": {
      "type": "string",
      "pattern": "^urn:evllm:policy:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "relationship_version": { "$ref": "#/$defs/__schema0" },
    "bundle_controller_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "domain_controller_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "primary_repository_id": {
      "type": "string",
      "pattern": "^urn:evllm:repository:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "primary_operator_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "replica_controller_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "replica_operator_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "permitted_bundle_types": {
      "minItems": 1,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema1" }
    },
    "resource_scope": {
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema2" }
    },
    "effective_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "status": { "type": "string", "enum": ["pending", "active", "retired"] }
  },
  "required": [
    "schema",
    "relationship_id",
    "relationship_version",
    "bundle_controller_organization_id",
    "domain_controller_organization_id",
    "primary_repository_id",
    "primary_operator_organization_id",
    "replica_controller_organization_id",
    "replica_operator_organization_id",
    "permitted_bundle_types",
    "resource_scope",
    "effective_at",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": {
      "type": "string",
      "enum": [
        "evidence",
        "verification",
        "assessment",
        "assistant-support",
        "listing",
        "agreement",
        "dispute",
        "logistics",
        "audit",
        "authoritative-source"
      ]
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "resource_id": { "type": "string", "minLength": 1 },
        "resource_version": { "$ref": "#/$defs/__schema0" }
      },
      "required": ["resource_id"],
      "additionalProperties": false
    }
  }
}
