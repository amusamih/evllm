{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_DERIVED_ARTIFACT_DESCRIPTOR_V1" },
    "artifact_id": {
      "type": "string",
      "pattern": "^urn:evllm:link:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "artifact_version": { "$ref": "#/$defs/__schema0" },
    "source_bundle_id": {
      "type": "string",
      "pattern": "^urn:evllm:bundle:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source_bundle_version": { "$ref": "#/$defs/__schema0" },
    "source_bundle_type": {
      "type": "string",
      "enum": [
        "evidence",
        "verification",
        "assessment",
        "assistant-support",
        "listing",
        "agreement",
        "dispute",
        "logistics",
        "audit",
        "authoritative-source"
      ]
    },
    "source_domain_resource_id": { "type": "string", "pattern": "^urn:evllm:.*" },
    "source_domain_resource_version": { "$ref": "#/$defs/__schema0" },
    "artifact_type": { "$ref": "#/$defs/__schema1" },
    "custodian_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "purpose_id": {
      "type": "string",
      "pattern": "^urn:evllm:policy:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^urn:evllm:policy:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "policy_version": { "$ref": "#/$defs/__schema0" },
    "method_profile_id": {
      "type": "string",
      "pattern": "^urn:evllm:profile:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "method_profile_version": { "$ref": "#/$defs/__schema0" },
    "model_profile_id": {
      "type": "string",
      "pattern": "^urn:evllm:profile:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "model_profile_version": { "$ref": "#/$defs/__schema0" },
    "status": { "type": "string", "enum": ["active", "invalidated"] },
    "retention_profile_id": {
      "type": "string",
      "pattern": "^urn:evllm:profile:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "retention_profile_version": { "$ref": "#/$defs/__schema0" },
    "artifact_digest": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "required": ["alg", "value"],
      "additionalProperties": false
    },
    "index_namespace": { "$ref": "#/$defs/__schema1" },
    "invalidation_reason": { "$ref": "#/$defs/__schema1" },
    "invalidated_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  },
  "required": [
    "schema",
    "artifact_id",
    "artifact_version",
    "source_bundle_id",
    "source_bundle_version",
    "source_bundle_type",
    "source_domain_resource_id",
    "source_domain_resource_version",
    "artifact_type",
    "custodian_organization_id",
    "purpose_id",
    "policy_id",
    "policy_version",
    "method_profile_id",
    "method_profile_version",
    "status",
    "retention_profile_id",
    "retention_profile_version",
    "artifact_digest",
    "index_namespace"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
