{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_RECIPIENT_KEY_ROTATION_CAMPAIGN_V1" },
    "campaign_id": {
      "type": "string",
      "pattern": "^urn:evllm:campaign:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "campaign_version": { "$ref": "#/$defs/__schema0" },
    "recipient_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "administrator_actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "administrator_credential_id": {
      "type": "string",
      "pattern": "^urn:evllm:credential:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "predecessor_key_id": {
      "type": "string",
      "pattern": "^urn:evllm:key:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "successor_key_id": {
      "type": "string",
      "pattern": "^urn:evllm:key:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "required_items": {
      "minItems": 1,
      "maxItems": 4096,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema1" }
    },
    "required_set_digest": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "required": ["alg", "value"],
      "additionalProperties": false
    },
    "required_count": { "$ref": "#/$defs/__schema0" },
    "nonce": { "$ref": "#/$defs/__schema2" },
    "issued_at": { "$ref": "#/$defs/__schema3" },
    "expires_at": { "$ref": "#/$defs/__schema3" },
    "idempotency_key_hash": { "$ref": "#/$defs/__schema2" },
    "signature": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"
    },
    "state": {
      "type": "string",
      "enum": ["prepared", "in-progress", "complete", "expired", "failed"]
    }
  },
  "required": [
    "schema",
    "campaign_id",
    "campaign_version",
    "recipient_organization_id",
    "administrator_actor_id",
    "administrator_credential_id",
    "predecessor_key_id",
    "successor_key_id",
    "required_items",
    "required_set_digest",
    "required_count",
    "nonce",
    "issued_at",
    "expires_at",
    "idempotency_key_hash",
    "signature",
    "state"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^urn:evllm:grant:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "envelope_id": {
          "type": "string",
          "pattern": "^urn:evllm:envelope:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^urn:evllm:bundle:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "bundle_version": { "$ref": "#/$defs/__schema0" },
        "outcome": { "type": "string", "enum": ["pending", "complete", "unavailable", "failed"] }
      },
      "required": ["grant_id", "envelope_id", "bundle_id", "bundle_version", "outcome"],
      "additionalProperties": false
    },
    "__schema2": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "__schema3": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
