{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_PROTECTED_BUNDLE_STAGING_STATE_V1" },
    "staging_id": {
      "type": "string",
      "pattern": "^urn:evllm:staging:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "state": {
      "type": "string",
      "enum": ["preparing", "prepared", "finalized", "expired", "rejected"]
    },
    "state_revision": { "$ref": "#/$defs/__schema0" },
    "materialization_revision": { "$ref": "#/$defs/__schema0" },
    "preparation_idempotency_key_hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "preparation_request_fingerprint": { "$ref": "#/$defs/__schema1" },
    "reserved_ids": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema2" }
    },
    "staging_descriptor_digest": { "$ref": "#/$defs/__schema1" },
    "preparation_command_id": {
      "type": "string",
      "pattern": "^urn:evllm:command:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "finalization_command_id": {
      "type": "string",
      "pattern": "^urn:evllm:command:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "retained_result_ref": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/__schema0" }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "preparing_at": { "$ref": "#/$defs/__schema3" },
    "materialization_expires_at": { "$ref": "#/$defs/__schema3" },
    "prepared_at": { "$ref": "#/$defs/__schema3" },
    "expires_at": { "$ref": "#/$defs/__schema3" },
    "finalized_at": { "$ref": "#/$defs/__schema3" },
    "closed_at": { "$ref": "#/$defs/__schema3" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "audit_event_id": {
      "type": "string",
      "pattern": "^urn:evllm:event:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "schema",
    "staging_id",
    "state",
    "state_revision",
    "materialization_revision",
    "preparation_idempotency_key_hash",
    "preparation_request_fingerprint",
    "reserved_ids",
    "preparation_command_id",
    "preparing_at",
    "materialization_expires_at",
    "expires_at",
    "correlation_id",
    "audit_event_id"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "required": ["alg", "value"],
      "additionalProperties": false
    },
    "__schema2": { "type": "string", "pattern": "^urn:evllm:.*" },
    "__schema3": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
