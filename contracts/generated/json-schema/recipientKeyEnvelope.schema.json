{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "$ref": "#/$defs/__schema0" },
    "envelope_id": { "$ref": "#/$defs/__schema1" },
    "envelope_version": { "$ref": "#/$defs/__schema2" },
    "bundle_id": { "$ref": "#/$defs/__schema3" },
    "bundle_version": { "$ref": "#/$defs/__schema2" },
    "recipient_organization_id": { "$ref": "#/$defs/__schema4" },
    "recipient_key_id": { "$ref": "#/$defs/__schema5" },
    "recipient_key_thumbprint_uri": { "$ref": "#/$defs/__schema6" },
    "grant_id": { "$ref": "#/$defs/__schema7" },
    "controller_authorization_id": { "$ref": "#/$defs/__schema8" },
    "purpose_id": { "$ref": "#/$defs/__schema9" },
    "scope": { "$ref": "#/$defs/__schema10" },
    "policy_id": { "$ref": "#/$defs/__schema11" },
    "policy_version": { "$ref": "#/$defs/__schema2" },
    "jwe": { "$ref": "#/$defs/__schema12" },
    "envelope_commitment": { "$ref": "#/$defs/__schema14" },
    "status": { "$ref": "#/$defs/__schema15" },
    "created_at": { "$ref": "#/$defs/__schema16" },
    "activated_at": { "$ref": "#/$defs/__schema17" },
    "retired_at": { "$ref": "#/$defs/__schema18" }
  },
  "required": [
    "schema",
    "envelope_id",
    "envelope_version",
    "bundle_id",
    "bundle_version",
    "recipient_organization_id",
    "recipient_key_id",
    "recipient_key_thumbprint_uri",
    "purpose_id",
    "scope",
    "policy_id",
    "policy_version",
    "jwe",
    "envelope_commitment",
    "status",
    "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "string", "const": "EVLLM_RECIPIENT_KEY_ENVELOPE_V1" },
    "__schema1": {
      "type": "string",
      "pattern": "^urn:evllm:envelope:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema2": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema3": {
      "type": "string",
      "pattern": "^urn:evllm:bundle:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema4": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema5": {
      "type": "string",
      "pattern": "^urn:evllm:key:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema6": { "type": "string", "minLength": 1, "maxLength": 256 },
    "__schema7": {
      "type": "string",
      "pattern": "^urn:evllm:grant:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema8": {
      "type": "string",
      "pattern": "^urn:evllm:authorization:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema9": {
      "type": "string",
      "pattern": "^urn:evllm:policy:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema10": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema6" }
    },
    "__schema11": {
      "type": "string",
      "pattern": "^urn:evllm:policy:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "protected": { "$ref": "#/$defs/__schema13" },
        "aad": { "$ref": "#/$defs/__schema13" },
        "encrypted_key": { "$ref": "#/$defs/__schema13" },
        "iv": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16}$" },
        "ciphertext": { "$ref": "#/$defs/__schema13" },
        "tag": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" }
      },
      "required": ["protected", "aad", "encrypted_key", "iv", "ciphertext", "tag"],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "required": ["alg", "value"],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "string",
      "enum": ["staged", "active", "retired", "revoked", "unavailable"]
    },
    "__schema16": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "__schema17": { "$ref": "#/$defs/__schema16" },
    "__schema18": { "$ref": "#/$defs/__schema16" }
  }
}
