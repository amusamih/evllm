{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_AUTHOR_BINDING_DECISION_V1" },
    "decision_id": {
      "type": "string",
      "pattern": "^urn:evllm:decision:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "decision_version": { "$ref": "#/$defs/__schema0" },
    "bundle_id": {
      "type": "string",
      "pattern": "^urn:evllm:bundle:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "bundle_version": { "$ref": "#/$defs/__schema0" },
    "bundle_type": {
      "type": "string",
      "enum": [
        "evidence",
        "verification",
        "assessment",
        "assistant-support",
        "listing",
        "agreement",
        "dispute",
        "logistics",
        "audit",
        "authoritative-source"
      ]
    },
    "domain_resource_id": { "type": "string", "pattern": "^urn:evllm:.*" },
    "domain_resource_version": { "$ref": "#/$defs/__schema0" },
    "domain_payload_commitment": { "$ref": "#/$defs/__schema1" },
    "preparation_request_fingerprint": { "$ref": "#/$defs/__schema1" },
    "author_binding_profile_id": {
      "type": "string",
      "pattern": "^urn:evllm:profile:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "author_binding_profile_version": { "$ref": "#/$defs/__schema0" },
    "intended_author_actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "intended_author_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "intended_author_credential_id": {
      "type": "string",
      "pattern": "^urn:evllm:credential:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "intended_author_address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "selected_role_id": {
      "type": "string",
      "pattern": "^urn:evllm:role:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "selected_capability_id": {
      "type": "string",
      "pattern": "^urn:evllm:capability:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "discriminator": { "type": "string", "minLength": 1, "maxLength": 256 },
    "relationship_operands": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "type": "string" }
    },
    "relationship_source": {
      "type": "object",
      "properties": {
        "resource_id": { "type": "string", "minLength": 1 },
        "resource_version": { "$ref": "#/$defs/__schema0" }
      },
      "required": ["resource_id"],
      "additionalProperties": false
    },
    "equality_result": { "type": "string", "const": "allow" },
    "relationship_result": { "type": "string", "const": "allow" },
    "evaluated_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "decision_digest": { "$ref": "#/$defs/__schema1" }
  },
  "required": [
    "schema",
    "decision_id",
    "decision_version",
    "bundle_id",
    "bundle_version",
    "bundle_type",
    "domain_resource_id",
    "domain_resource_version",
    "domain_payload_commitment",
    "preparation_request_fingerprint",
    "author_binding_profile_id",
    "author_binding_profile_version",
    "intended_author_actor_id",
    "intended_author_organization_id",
    "intended_author_credential_id",
    "intended_author_address",
    "selected_role_id",
    "selected_capability_id",
    "discriminator",
    "relationship_operands",
    "relationship_source",
    "equality_result",
    "relationship_result",
    "evaluated_at",
    "decision_digest"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "const": "SHA-256" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      },
      "required": ["alg", "value"],
      "additionalProperties": false
    }
  }
}
