{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "$ref": "#/$defs/__schema0" },
    "run_id": { "$ref": "#/$defs/__schema1" },
    "config_id": { "$ref": "#/$defs/__schema2" },
    "config_version": { "$ref": "#/$defs/__schema3" },
    "config_sha256": { "$ref": "#/$defs/__schema4" },
    "started_at": { "$ref": "#/$defs/__schema5" },
    "completed_at": { "$ref": "#/$defs/__schema6" },
    "result_directory": { "$ref": "#/$defs/__schema7" },
    "secrets_included": { "$ref": "#/$defs/__schema8" },
    "metrics": { "$ref": "#/$defs/__schema9" }
  },
  "required": [
    "schema",
    "run_id",
    "config_id",
    "config_version",
    "config_sha256",
    "started_at",
    "completed_at",
    "result_directory",
    "secrets_included",
    "metrics"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "string", "const": "EVLLM_EVALUATION_RUN_V1" },
    "__schema1": {
      "type": "string",
      "pattern": "^urn:evllm:event:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^urn:evllm:case:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema3": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema4": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "__schema5": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema6": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema7": {
      "type": "string",
      "pattern": "^(?:evaluation\\/development|evaluation\\/formal)\\/[a-z0-9][a-z0-9_-]*$"
    },
    "__schema8": { "type": "boolean", "const": false },
    "__schema9": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "value": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" }
        },
        "required": ["metric_id", "value"],
        "additionalProperties": false
      }
    }
  }
}
