{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_DISPUTE_RECORD_V1" },
    "dispute_id": {
      "type": "string",
      "pattern": "^urn:evllm:dispute:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "dispute_version": { "$ref": "#/$defs/__schema0" },
    "submission_payload_refs": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema1" }
    },
    "domain_signature_record_ids": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": { "$ref": "#/$defs/__schema2" }
    },
    "state": {
      "type": "string",
      "enum": ["open", "under-review", "resolved", "rejected", "withdrawn"]
    },
    "resolver_actor_id": {
      "type": "string",
      "pattern": "^urn:evllm:actor:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "outcome": { "type": "string", "enum": ["upheld", "rejected", "settled", "withdrawn"] },
    "opened_at": { "$ref": "#/$defs/__schema3" },
    "resolved_at": { "$ref": "#/$defs/__schema3" },
    "chain_locators": { "maxItems": 256, "type": "array", "items": { "$ref": "#/$defs/__schema4" } }
  },
  "required": [
    "schema",
    "dispute_id",
    "dispute_version",
    "submission_payload_refs",
    "domain_signature_record_ids",
    "state",
    "opened_at",
    "chain_locators"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/__schema0" }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "pattern": "^urn:evllm:assertion:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "__schema3": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "__schema4": {
      "type": "object",
      "properties": {
        "chain_id": { "$ref": "#/$defs/__schema0" },
        "transaction_hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
        "block_number": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "log_index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["chain_id", "transaction_hash", "block_number", "log_index"],
      "additionalProperties": false
    }
  }
}
