{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lower": { "$ref": "#/$defs/__schema0" },
    "upper": { "$ref": "#/$defs/__schema0" }
  },
  "required": ["lower", "upper"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^(?:0|-?(?:[1-9][0-9]*)(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$"
    }
  }
}
