{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "const": "EVLLM_REPLICA_RECORD_V1" },
    "replica_id": {
      "type": "string",
      "pattern": "^urn:evllm:replica:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "replica_version": { "$ref": "#/$defs/__schema0" },
    "bundle_id": {
      "type": "string",
      "pattern": "^urn:evllm:bundle:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "bundle_version": { "$ref": "#/$defs/__schema0" },
    "primary_repository_id": {
      "type": "string",
      "pattern": "^urn:evllm:repository:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "replica_repository_id": {
      "type": "string",
      "pattern": "^urn:evllm:repository:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "primary_object_id": { "$ref": "#/$defs/__schema1" },
    "replica_object_id": { "$ref": "#/$defs/__schema1" },
    "content_envelope_digest": { "$ref": "#/$defs/__schema2" },
    "stored_envelope_length": { "$ref": "#/$defs/__schema0" },
    "state": {
      "type": "string",
      "enum": ["pending", "stored", "verified", "failed", "reorganized"]
    },
    "attempt": { "$ref": "#/$defs/__schema0" },
    "attempted_at": { "$ref": "#/$defs/__schema3" },
    "verification_result": { "type": "string", "enum": ["pass", "fail"] },
    "receipt_nonce": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "observed_at": { "$ref": "#/$defs/__schema3" },
    "expires_at": { "$ref": "#/$defs/__schema3" },
    "custodian_organization_id": {
      "type": "string",
      "pattern": "^urn:evllm:org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "signer_credential_id": {
      "type": "string",
      "pattern": "^urn:evllm:credential:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "receipt_signature": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$"
    },
    "receipt_digest": { "$ref": "#/$defs/__schema2" },
    "failure_reason": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "required": [
    "schema",
    "replica_id",
    "replica_version",
    "bundle_id",
    "bundle_version",
    "primary_repository_id",
    "replica_repository_id",
    "primary_object_id",
    "replica_object_id",
    "content_envelope_digest",
    "stored_envelope_length",
    "state",
    "attempt",
    "attempted_at",
    "verification_result",
    "receipt_nonce",
    "observed_at",
    "expires_at",
    "custodian_organization_id",
    "signer_credential_id",
    "receipt_signature",
    "receipt_digest"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "__schema1": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "__schema2": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "const": "SHA-256" },
        "value": { "$ref": "#/$defs/__schema1" }
      },
      "required": ["alg", "value"],
      "additionalProperties": false
    },
    "__schema3": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
