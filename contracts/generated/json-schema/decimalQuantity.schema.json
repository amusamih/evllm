{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "value": {
      "type": "string",
      "pattern": "^(?:0|-?(?:[1-9][0-9]*)(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^urn:evllm:unit:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "unit_version": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
  },
  "required": ["value", "unit_id", "unit_version"],
  "additionalProperties": false
}
