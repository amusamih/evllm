    "/api/v1/protected-bundles/staging": {
      "post": {
        "operationId": "prepareProtectedBundle",
        "summary": "Prepare an immutable protected-bundle staging object",
        "security": [{ "walletSession": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./json-schema/prepareProtectedBundleRequest.schema.json" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prepared descriptor, including an exact idempotent replay of an existing result.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./json-schema/protectedBundleStagingDescriptor.schema.json" }
              }
            }
          },
          "default": {
            "description": "Generic rejected or unavailable preparation result.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/protected-bundles/staging/{stagingId}/domain-attestation-challenge": {
      "post": {
        "operationId": "consumeDomainAttestationChallenge",
        "summary": "Consume the intended author's one-use domain-attestation challenge",
        "security": [{ "walletSession": [] }],
        "parameters": [
          {
            "name": "stagingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^urn:evllm:staging:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The reconstructed one-use challenge for the exact intended author.",
            "headers": { "Cache-Control": { "schema": { "type": "string", "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": { "$ref": "./json-schema/domainAttestationChallenge.schema.json" }
              }
            }
          },
          "default": {
            "description": "Generic unavailable response for unauthorized, expired, replayed, finalized, or absent challenges.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/query/protected-bundles": {
      "get": {
        "operationId": "getQueryProtectedBundles",
        "summary": "Controller/type/domain linkage, access/criticality/replica/availability metadata, authorized ciphertext/content retrieval and repository-local search; no domain-state mutation occurs. The route may append only its immutable access decision, one-use/idempotent key-capability issue/consume/result state, and minimized access audit required to enforce the read",
        "security": [{ "walletSession": [] }],
        "responses": {
          "200": {
            "description": "Successful response at an explicit version and as-of boundary.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/QueryResponse" } }
            }
          },
          "default": {
            "description": "Safe versioned error response.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/query/evidence": {
      "get": {
        "operationId": "getQueryEvidence",
        "summary": "Metadata, existing-grant status, request-specific access outcome, repository availability, authorized fetch/search, replica state, and protocol support; no domain-state mutation occurs. The route may append only the same fail-closed access-security/idempotency records and minimized audit required for the read",
        "security": [{ "walletSession": [] }],
        "responses": {
          "200": {
            "description": "Successful response at an explicit version and as-of boundary.",
