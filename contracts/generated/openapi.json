      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "correlation_id", "code", "message"],
        "properties": {
          "schema_version": { "type": "string", "const": "1.0.0" },
          "correlation_id": { "type": "string", "format": "uuid" },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "message": { "type": "string", "minLength": 1 },
          "field_violations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "code"],
              "properties": { "field": { "type": "string" }, "code": { "type": "string" } }
            }
          }
        }
      },
      "QueryResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "correlation_id", "as_of", "data"],
        "properties": {
          "schema_version": { "type": "string", "const": "1.0.0" },
          "correlation_id": { "type": "string", "format": "uuid" },
          "as_of": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chain_id", "block_number", "observed_at"],
            "properties": {
              "chain_id": { "type": "integer", "minimum": 1 },
