# Copy this file to .env/test.env for isolated integration tests.
# The test database uses a separate Compose project, port, name, and volume.

APP_ENV=test
EVLLM_HTTP_HOST=127.0.0.1
PORT=3100

EVLLM_DB_HOST=127.0.0.1
EVLLM_DB_PORT=55432
EVLLM_DB_NAME=evllm_test
EVLLM_DB_USER=evllm_test
EVLLM_DB_PASSWORD=replace_with_test_database_password

RUN_STORAGE_INTEGRATION=1
EVLLM_ORG_A_S3_ENDPOINT=http://127.0.0.1:18333
EVLLM_ORG_A_S3_ACCESS_KEY=replace_with_org_a_test_access_key
EVLLM_ORG_A_S3_SECRET_KEY=replace_with_org_a_test_secret_key
EVLLM_ORG_B_S3_ENDPOINT=http://127.0.0.1:28333
EVLLM_ORG_B_S3_ACCESS_KEY=replace_with_org_b_test_access_key
EVLLM_ORG_B_S3_SECRET_KEY=replace_with_org_b_test_secret_key
