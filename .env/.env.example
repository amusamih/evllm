# Copy this file to .env/local.env and replace each placeholder needed by the commands you run.
# .env/local.env is ignored by Git.

APP_ENV=development
EVLLM_HTTP_HOST=127.0.0.1
PORT=3000

# Public address of the wallet permitted to use the controlled authenticated interface.
# The server never needs this wallet's private key.
EVLLM_CONTROLLED_WALLET_ADDRESS=replace_with_local_demo_wallet_address

EVLLM_DB_HOST=127.0.0.1
EVLLM_DB_PORT=5432
EVLLM_DB_NAME=evllm
EVLLM_DB_USER=evllm
EVLLM_DB_PASSWORD=replace_with_local_database_password

OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini-2024-07-18

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/replace_with_alchemy_api_key
SEPOLIA_DEPLOYER_PRIVATE_KEY=0x_replace_with_sepolia_only_deployer_private_key

ETHERSCAN_API_KEY=replace_with_etherscan_api_key
