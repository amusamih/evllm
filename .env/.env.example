# Copy this file to .env/local.env. The current foundation requires the database,
# document-encryption, and session placeholders below. Later integrations require
# their own API and deployment values. .env/local.env is ignored by Git.

APP_ENV=development
PORT=3000

EVLLM_DB_HOST=127.0.0.1
EVLLM_DB_PORT=5432
EVLLM_DB_NAME=evllm
EVLLM_DB_USER=evllm
EVLLM_DB_PASSWORD=replace_with_local_database_password

DOCUMENT_STORE_PATH=data/protected-evidence
# Generate exactly 32 random bytes and encode them as Base64.
DOCUMENT_ENCRYPTION_KEY=replace_with_32_byte_base64_key
SESSION_SECRET=replace_with_random_session_secret

OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini-2024-07-18

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/replace_with_alchemy_api_key
SEPOLIA_DEPLOYER_PRIVATE_KEY=0x_replace_with_sepolia_only_deployer_private_key

ETHERSCAN_API_KEY=replace_with_etherscan_api_key
CONTRACT_ADDRESS=replace_with_deployed_contract_address
